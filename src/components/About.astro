---
import { Fish, Pizza, Martini } from "lucide-astro";
import { site } from "../data/site";

const facts = [
  { icon: Fish, title: "Crudo di mare", text: "Tartare, ostriche e gambero rosso di Mazara, freschissimi." },
  { icon: Pizza, title: "Pizzeria", text: "Pizze classiche e proposte della casa, cotte al momento." },
  { icon: Martini, title: "Aperitivo al tramonto", text: "Cocktail bar con la vista più bella di Barcarello." },
];
---

<section id="storia" class="about relative min-h-svh flex items-center py-20 lg:py-28 px-6 bg-navy text-white overflow-hidden">
  <div class="about__bg absolute inset-0">
    <!-- Schermi orizzontali (desktop): il locale illuminato di sera in WebP. Il browser sceglie
         la larghezza adatta e la scarica solo quando la sezione si avvicina. -->
    <img
      class="about__photo absolute inset-0 size-full object-cover"
      src="/images/chisiamo-sunset-1280.webp"
      srcset="/images/chisiamo-sunset-768.webp 768w, /images/chisiamo-sunset-1280.webp 1280w, /images/chisiamo-sunset-1920.webp 1920w"
      sizes="100vw"
      width="1920"
      height="1072"
      alt=""
      aria-hidden="true"
      loading="lazy"
      decoding="async"
    />
    <!-- Schermi verticali (telefono, tablet in verticale): video verticale del tramonto sull'Isola
         delle Femmine, in loop senza stacchi. Il src viene impostato dallo script solo su questi
         schermi e solo quando la sezione si avvicina: il desktop non lo scarica mai. -->
    <video
      class="about__video absolute inset-0 size-full object-cover"
      data-src="/video/chisiamo-mobile.mp4"
      poster="/video/chisiamo-mobile-poster.webp"
      muted
      loop
      playsinline
      preload="none"
      aria-hidden="true"
    ></video>
  </div>
  <!-- Velo: su desktop più scuro a sinistra (dove sta il testo); in verticale dall'alto al basso,
       più leggero al centro per lasciar vedere il sole e il riflesso sul mare. -->
  <div class="about__veil absolute inset-0"></div>

  <div class="relative z-10 max-w-[1200px] mx-auto grid lg:grid-cols-2 gap-12 items-center">
    <div>
      <p class="reveal reveal--up text-gold uppercase tracking-[0.3em] text-xs font-semibold mb-3" style="--d: 0ms">Chi siamo</p>
      <h2 class="reveal reveal--up text-4xl lg:text-5xl font-bold leading-tight" style="--d: 120ms">Il mare, la pizza, il tramonto</h2>
      <span class="reveal reveal--line block h-0.5 w-16 bg-gold mt-6" style="--d: 300ms" aria-hidden="true"></span>
      <p class="reveal reveal--up mt-6 text-lg text-white/75 leading-relaxed" style="--d: 380ms">
        <!-- TODO: storia reale del locale, raccontata dal cliente -->
        {site.shortName} Barcarello è pizzeria, ristorante e apericena affacciata sul mare di Palermo, nel tratto di costa di Barcarello. Cucina di mare, crudi freschissimi e pizza, da gustare mentre il sole tramonta sull'acqua.
      </p>
      <p class="reveal reveal--up mt-4 text-lg text-white/75 leading-relaxed" style="--d: 500ms">
        Perfetto per un aperitivo tra amici, una cena in coppia o una tavolata da condividere, con vista che cambia colore a ogni ora.
      </p>
    </div>

    <ul class="grid gap-4">
      {facts.map((f, i) => (
        <li
          class="reveal reveal--card about-card flex items-start gap-5 rounded-2xl border border-white/10 bg-white/5 p-6 backdrop-blur-sm"
          style={`--d: ${250 + i * 180}ms`}
        >
          <span class="about-card__icon size-12 shrink-0 rounded-xl bg-primary/20 text-gold flex items-center justify-center">
            <f.icon class="size-6" />
          </span>
          <div>
            <h3 class="text-xl font-bold">{f.title}</h3>
            <p class="text-white/70 mt-1">{f.text}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  /* Le animazioni partono solo se lo script ha marcato la sezione con .is-armed:
     senza JavaScript (o con "riduci animazioni") il contenuto è sempre visibile. */
  .about.is-armed .reveal {
    opacity: 0;
    transition:
      opacity var(--dur, 0.8s) cubic-bezier(0.22, 1, 0.36, 1) calc(var(--d, 0ms) * var(--k, 1)),
      transform calc(var(--dur, 0.8s) + 0.1s) cubic-bezier(0.22, 1, 0.36, 1) calc(var(--d, 0ms) * var(--k, 1));
    will-change: opacity, transform;
  }

  /* Testo: sale dal basso. */
  .about.is-armed .reveal--up {
    transform: translateY(28px);
  }

  /* Linea dorata: si allunga da sinistra. */
  .about.is-armed .reveal--line {
    transform: scaleX(0);
    transform-origin: left;
  }

  /* Card: entrano da destra, una dopo l'altra, con un leggero zoom. */
  .about.is-armed .reveal--card {
    transform: translateX(48px) scale(0.96);
  }

  .about.is-armed .reveal--card .about-card__icon {
    transform: scale(0.4) rotate(-20deg);
    opacity: 0;
    transition:
      transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) calc(var(--d, 0ms) * var(--k, 1) + 350ms),
      opacity 0.4s ease calc(var(--d, 0ms) * var(--k, 1) + 350ms);
  }

  /* Schermi verticali: il video è il protagonista. Gli elementi arrivano con più calma
     (cascata più distanziata e movimenti più lenti); la pausa iniziale la gestisce lo script. */
  @media (orientation: portrait) and (max-width: 1023px) {
    .about {
      --k: 5;      /* cascata ~5 volte più distesa: ~3 s dal primo all'ultimo elemento */
      --dur: 1.3s;
    }
  }

  .about.is-armed.is-visible .reveal {
    opacity: 1;
    transform: none;
  }

  .about.is-armed.is-visible .reveal--card .about-card__icon {
    opacity: 1;
    transform: none;
  }

  /* Finita l'entrata (.is-settled), le card rispondono subito all'hover, senza i ritardi della cascata. */
  .about.is-settled .reveal--card,
  .about:not(.is-armed) .about-card {
    transition:
      transform 0.3s ease,
      border-color 0.3s ease,
      background-color 0.3s ease;
  }

  /* Hover sulle card (desktop): si sollevano e il bordo si scalda d'oro. */
  @media (hover: hover) {
    .about.is-armed.is-settled .about-card:hover,
    .about:not(.is-armed) .about-card:hover {
      transform: translateY(-4px);
      border-color: color-mix(in srgb, var(--color-gold) 45%, transparent);
      background-color: rgb(255 255 255 / 0.09);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .about-card:hover {
      transform: none !important;
    }
  }

  /* Sfondo: foto su schermi orizzontali, video su schermi verticali stretti. */
  .about__video {
    display: none;
  }

  .about__veil {
    background: linear-gradient(
      to right,
      color-mix(in srgb, var(--color-navy) 85%, transparent),
      color-mix(in srgb, var(--color-navy) 60%, transparent),
      color-mix(in srgb, var(--color-navy) 40%, transparent)
    );
  }

  @media (orientation: portrait) and (max-width: 1023px) {
    .about__photo {
      display: none;
    }

    .about__video {
      display: block;
    }

    .about__veil {
      background: linear-gradient(
        to bottom,
        color-mix(in srgb, var(--color-navy) 80%, transparent) 0%,
        color-mix(in srgb, var(--color-navy) 55%, transparent) 45%,
        color-mix(in srgb, var(--color-navy) 70%, transparent) 75%,
        color-mix(in srgb, var(--color-navy) 90%, transparent) 100%
      );
    }
  }

  /* Sfondo leggermente più grande: lascia margine al parallax senza scoprire i bordi. */
  .about.is-armed .about__bg {
    transform: scale(1.12);
    will-change: transform;
  }
</style>

<script>
  const section = document.querySelector<HTMLElement>(".about");
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // Video di sfondo per schermi verticali: caricato solo lì, solo quando la sezione si avvicina,
  // in pausa quando esce dallo schermo (risparmia batteria e dati). Con "riduci animazioni"
  // resta il poster fermo.
  const video = section?.querySelector<HTMLVideoElement>(".about__video");
  const portrait = window.matchMedia("(orientation: portrait) and (max-width: 1023px)");

  if (section && video && !reduceMotion && "IntersectionObserver" in window) {
    let inView = false;

    const sync = () => {
      if (!portrait.matches) {
        video.pause();
        return;
      }
      if (inView) {
        if (!video.src) video.src = video.dataset.src!;
        video.play().catch(() => {});
      } else {
        video.pause();
      }
    };

    new IntersectionObserver(
      (entries) => {
        inView = entries[0].isIntersecting;
        sync();
      },
      { rootMargin: "200px 0px" }
    ).observe(section);

    portrait.addEventListener("change", sync);
  }

  if (section && !reduceMotion && "IntersectionObserver" in window) {
    section.classList.add("is-armed");

    // Su desktop il contenuto compare appena la sezione entra per un quarto.
    // In verticale lasciamo prima "respirare" il video: la sezione deve arrivare nella parte alta
    // dello schermo e restarci HOLD_MS prima che il testo entri. Se però il visitatore continua a
    // scorrere dentro la sezione, il contenuto compare subito: non deve mai trovare la sezione vuota.
    const isPortrait = portrait.matches;
    const HOLD_MS = isPortrait ? 2500 : 0;
    let revealed = false;
    let holdTimer = 0;

    const reveal = () => {
      if (revealed) return;
      revealed = true;
      clearTimeout(holdTimer);
      section.classList.add("is-visible");
      revealObserver.disconnect();
      window.removeEventListener("scroll", onScrollPast);
      // A cascata conclusa togliamo i ritardi per l'hover (in verticale la cascata è più lunga).
      setTimeout(() => section.classList.add("is-settled"), isPortrait ? 5000 : 1700);
    };

    const onScrollPast = () => {
      // La sezione è già salita di un quarto di schermo: il visitatore sta leggendo, mostriamo tutto.
      if (section.getBoundingClientRect().top < -window.innerHeight * 0.25) reveal();
    };

    const revealObserver = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) {
          // Uscita prima della fine della pausa: si ricomincia al prossimo ingresso.
          clearTimeout(holdTimer);
          holdTimer = 0;
          return;
        }
        if (!HOLD_MS) return reveal();
        if (!holdTimer) holdTimer = window.setTimeout(reveal, HOLD_MS);
      },
      isPortrait ? { rootMargin: "0px 0px -60% 0px" } : { threshold: 0.25 }
    );
    revealObserver.observe(section);
    if (isPortrait) window.addEventListener("scroll", onScrollPast, { passive: true });

    // Parallax leggero dello sfondo, calcolato solo mentre la sezione è a schermo.
    const bg = section.querySelector<HTMLElement>(".about__bg");
    if (bg) {
      let active = false;
      let ticking = false;

      const update = () => {
        ticking = false;
        const rect = section.getBoundingClientRect();
        const vh = window.innerHeight;
        // -1 quando la sezione entra dal basso, +1 quando esce dall'alto.
        const p = Math.max(-1, Math.min(1, (vh / 2 - (rect.top + rect.height / 2)) / ((vh + rect.height) / 2)));
        bg.style.transform = `translate3d(0, ${p * 40}px, 0) scale(1.12)`;
      };

      const onScroll = () => {
        if (!active || ticking) return;
        ticking = true;
        requestAnimationFrame(update);
      };

      new IntersectionObserver((entries) => {
        active = entries[0].isIntersecting;
        if (active) update();
      }).observe(section);

      window.addEventListener("scroll", onScroll, { passive: true });
    }
  }
</script>
