---
import { Star } from "lucide-astro";
import { site, reviews } from "../data/site";
---

<section class="py-20 lg:py-24 px-6 bg-navy text-white">
  <div class="max-w-[1200px] mx-auto">
    <div class="text-center max-w-2xl mx-auto">
      <div class="flex items-center justify-center gap-1 text-gold">
        {Array.from({ length: 5 }).map((_, i) => (
          <Star class="size-5" fill={i < Math.round(site.rating.value) ? "currentColor" : "none"} />
        ))}
      </div>
      <p class="mt-3 text-white/80">
        <span class="font-bold text-white">{site.rating.value}</span> su Google · {site.rating.count} recensioni
      </p>
    </div>

    <ul class="mt-12 grid md:grid-cols-3 gap-6">
      {reviews.map((r) => (
        <li class="rounded-2xl border border-white/10 bg-white/5 p-6 backdrop-blur-sm">
          <p class="text-white/90 leading-relaxed">"{r.text}"</p>
          <p class="mt-4 text-sm text-gold font-semibold">{r.author} · {r.source}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
