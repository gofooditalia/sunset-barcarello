---
import { Menu, X } from "lucide-astro";
import { site } from "../data/site";

const links = [
  { href: "/#home", label: "Home" },
  { href: "/#storia", label: "Chi siamo" },
  { href: "/#menu", label: "Menu" },
  ...(site.hasGallery ? [{ href: "/#gallery", label: "Gallery" }] : []),
  { href: "/#contatti", label: "Dove siamo" },
];
---

<header
  id="navbar"
  class="fixed top-0 left-0 w-full z-50 px-6 lg:px-10 py-4 transition-all duration-500"
>
  <div class="max-w-[1200px] mx-auto flex items-center justify-between">
    <a href="/" class="nav-link flex items-center" aria-label={site.name}>
      <img src="/images/logo-bianco-sm.webp" alt={site.name} width="500" height="210" class="h-10 lg:h-12 w-auto" />
    </a>

    <nav class="hidden lg:flex items-center gap-8">
      {links.map((l) => (
        <a href={l.href} class="nav-link text-white text-sm font-semibold hover:text-gold transition-colors">{l.label}</a>
      ))}
      <a
        href={site.menuUrl}
        target="_blank"
        rel="noopener"
        class="flex items-center justify-center rounded-lg h-11 px-6 bg-primary text-white text-sm font-black tracking-widest uppercase hover:bg-primary-dark transition-all shadow-lg shadow-primary/30 active:scale-95"
      >
        Vedi menu
      </a>
    </nav>

    <button id="mobile-menu-button" class="nav-link lg:hidden p-2 text-white" aria-label="Apri menu" aria-expanded="false">
      <Menu class="size-7" />
    </button>
  </div>

  <div id="mobile-menu" class="hidden lg:hidden fixed inset-0 bg-navy z-50 flex-col items-center justify-center gap-8">
    <button id="mobile-menu-close" class="absolute top-5 right-6 p-2 text-white" aria-label="Chiudi menu">
      <X class="size-8" />
    </button>
    <img src="/images/logo-bianco.webp" alt={site.name} width="1000" height="419" class="h-16 w-auto" />
    {links.map((l) => (
      <a href={l.href} class="mobile-link text-white text-2xl font-display hover:text-gold transition-colors">{l.label}</a>
    ))}
    <a href={site.menuUrl} target="_blank" rel="noopener" class="mobile-link mt-4 rounded-lg h-12 px-8 flex items-center bg-primary text-white font-black tracking-widest uppercase">
      Vedi menu
    </a>
  </div>
</header>

<script>
  const navbar = document.getElementById("navbar");
  const btn = document.getElementById("mobile-menu-button");
  const closeBtn = document.getElementById("mobile-menu-close");
  const menu = document.getElementById("mobile-menu");

  const toggle = (open: boolean) => {
    menu?.classList.toggle("hidden", !open);
    menu?.classList.toggle("flex", open);
    btn?.setAttribute("aria-expanded", String(open));
    document.body.style.overflow = open ? "hidden" : "";
  };

  btn?.addEventListener("click", () => toggle(true));
  closeBtn?.addEventListener("click", () => toggle(false));
  menu?.querySelectorAll(".mobile-link").forEach((a) => a.addEventListener("click", () => toggle(false)));

  const onScroll = () => {
    const scrolled = window.scrollY > 40;
    navbar?.classList.toggle("bg-navy/70", scrolled);
    navbar?.classList.toggle("backdrop-blur-lg", scrolled);
    navbar?.classList.toggle("backdrop-saturate-150", scrolled);
    navbar?.classList.toggle("border-b", scrolled);
    navbar?.classList.toggle("border-white/10", scrolled);
    navbar?.classList.toggle("shadow-md", scrolled);
  };
  window.addEventListener("scroll", onScroll, { passive: true });
  onScroll();
</script>
