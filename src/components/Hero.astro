---
import { site } from "../data/site";

// Sequenza di fotogrammi per lo scroll-scrub: timelapse del sole che tramonta dietro
// l'Isola delle Femmine, da mezzogiorno al tramonto (sunset_timelapse.mp4, 30fps/4.3s, 130 frame).
// Su mobile una sequenza dedicata: verticale 540×960, un fotogramma ogni due (65 frame, ~1,1 MB),
// ricavata da hero-mobile.mp4. Lo scrub resta fluido grazie alla dissolvenza tra frame adiacenti.
const FRAME_COUNT = 130;
const FRAME_COUNT_MOBILE = 65;
const framePath = (n: number) => `/frames/hero/frame-${String(n).padStart(4, "0")}.webp`;
const framePathMobile = (n: number) => `/frames/hero-mobile/frame-${String(n).padStart(4, "0")}.webp`;
---

<section
  id="home"
  class="hero-scrub relative bg-navy"
  data-frame-count={FRAME_COUNT}
  data-frame-count-mobile={FRAME_COUNT_MOBILE}
>
  <div class="hero-scrub__pin sticky top-0 h-svh overflow-hidden flex items-end justify-center">
    <canvas class="hero-scrub__canvas absolute inset-0 size-full" aria-hidden="true"></canvas>
    <video
      class="hero-scrub__video absolute inset-0 size-full object-cover hidden"
      muted
      playsinline
      preload="none"
      aria-hidden="true"
    >
      <!-- Niente loop: il timelapse va da mezzogiorno al tramonto e si ferma sull'ultimo frame
           (ricominciare da capo farebbe "saltare" il cielo da arancione ad azzurro). -->
      <source src="/video/hero-mobile.mp4" media="(max-width: 767px)" type="video/mp4" />
      <source src="/video/hero-1280.mp4" type="video/mp4" />
    </video>
    <picture>
      <source media="(max-width: 767px)" srcset={framePathMobile(1)} />
      <img
        class="hero-scrub__poster absolute inset-0 size-full object-cover"
        src={framePath(1)}
        alt=""
        aria-hidden="true"
        fetchpriority="high"
      />
    </picture>

    <div class="absolute inset-0 bg-gradient-to-t from-navy/90 via-navy/5 to-navy/20"></div>

    <!-- Logo e CTA nella parte alta, sul cielo: il blocco finisce poco sopra l'isolotto (che sta
         intorno al 66-70% dell'altezza), così sul finale il sole tramonta proprio sotto il logo. -->
    <div class="hero-scrub__content relative z-10 text-center px-6 max-w-2xl mx-auto pb-[38svh]">
      <h1 class="sr-only">{site.name} - Barcarello, Palermo</h1>

      <!-- Logo grande sopra la CTA: il nome del locale deve vedersi subito, non solo nella navbar. -->
      <img
        src="/images/logo-bianco.webp"
        alt=""
        aria-hidden="true"
        width="1000"
        height="419"
        class="hero-logo mx-auto mb-8 h-24 sm:h-28 lg:h-36 w-auto"
        fetchpriority="high"
      />

      <div class="flex flex-wrap items-center justify-center gap-4">
        <a
          href="#prenota"
          class="inline-flex rounded-lg h-13 px-8 items-center border-2 border-white/70 text-white font-black tracking-widest uppercase text-sm hover:bg-white/10 transition-all active:scale-95"
        >
          Prenota un tavolo
        </a>
      </div>

      {site.rating?.value && (
        <p class="mt-8 text-white/80 text-sm text-shadow">
          ⭐ {site.rating.value} su Google · {site.rating.count} recensioni
        </p>
      )}
      <p class="mt-2 text-white/90 text-sm font-semibold text-shadow">
        Aperti tutto l'anno · a cena · chiuso il martedì
      </p>
    </div>
  </div>
</section>

<noscript>
  <style>
    .hero-scrub { height: 100svh !important; }
    .hero-scrub__content { opacity: 1 !important; transform: none !important; pointer-events: auto !important; }
  </style>
</noscript>

<script is:inline>
  // Bloccante (non-module): gira PRIMA del primo paint, quindi decide subito se questa è
  // una sessione scroll-scrub (sezione alta 300vh, canvas; desktop e mobile) o una sessione
  // fallback ("riduci animazioni": video in autoplay). Evita salti di layout al primo paint.
  (function () {
    var section = document.querySelector(".hero-scrub");
    if (!section) return;
    var frameCount = Number(section.dataset.frameCount || 0);
    var prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (window.innerWidth < 768) {
      section.classList.add("is-mobile");
      frameCount = Number(section.dataset.frameCountMobile || 0);
    }
    if (prefersReducedMotion || !frameCount) {
      section.classList.add("is-content-visible");
    } else {
      section.classList.add("is-scrub-active");
    }
  })();
</script>

<style>
  /* Il contenuto (CTA "Prenota") è visibile da subito in ogni modalità: non dipende mai
     dal caricamento dei frame. In modalità scrub è lo script a sfumarlo durante l'animazione. */
  .hero-scrub {
    height: 100svh;
  }

  .hero-scrub__content.is-hidden {
    pointer-events: none;
  }

  .hero-scrub__canvas {
    display: none;
  }

  /* Modalità desktop: canvas scroll-scrub. */
  .hero-scrub.is-scrub-active {
    height: 300vh;
  }

  .hero-scrub.is-frames-ready .hero-scrub__canvas {
    display: block;
  }

  .hero-scrub.is-frames-ready .hero-scrub__poster {
    display: none;
  }

  /* Modalità mobile / riduci animazioni: video normale in autoplay, contenuto sempre visibile. */
  .hero-scrub.is-content-visible .hero-scrub__content {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  .hero-scrub.is-video-active .hero-scrub__video {
    display: block;
  }

  .hero-scrub.is-video-active .hero-scrub__poster {
    display: none;
  }

  .hero-logo {
    filter: drop-shadow(0 4px 18px rgba(0, 0, 0, 0.5));
  }

  .text-shadow {
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.45);
  }

  /* Rete di sicurezza puramente CSS: se lo script inline non parte (es. CSP che blocca
     inline script), un utente con "riduci animazioni" non resta comunque con testo nascosto. */
  @media (prefers-reduced-motion: reduce) {
    .hero-scrub:not(.is-content-visible) {
      height: 100svh;
    }
    .hero-scrub:not(.is-content-visible) .hero-scrub__content {
      opacity: 1;
      transform: none;
      pointer-events: auto;
    }
  }
</style>

<script>
  function framePath(n: number, mobile: boolean) {
    const dir = mobile ? "hero-mobile" : "hero";
    return `/frames/${dir}/frame-${String(n).padStart(4, "0")}.webp`;
  }

  function initHeroVideoFallback(section: HTMLElement) {
    const video = section.querySelector<HTMLVideoElement>(".hero-scrub__video");
    if (!video) return;
    section.classList.add("is-video-active");
    video.play().catch(() => {});
  }

  function initHeroScrub(section: HTMLElement, frameCount: number) {
    const canvas = section.querySelector<HTMLCanvasElement>(".hero-scrub__canvas");
    const content = section.querySelector<HTMLElement>(".hero-scrub__content");
    if (!canvas || !content) return;

    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    const mobile = section.classList.contains("is-mobile");

    const images: (HTMLImageElement | undefined)[] = new Array(frameCount);
    const loaded: boolean[] = new Array(frameCount).fill(false);
    let position = 0; // posizione corrente (frazionaria) nella sequenza, 0..frameCount-1
    let ready = false;
    let ticking = false;

    // Timeline del contenuto (CTA + rating), in % di scroll dell'hero:
    // visibile all'apertura, sparisce mentre scorre il "film", ricompare sul finale.
    const hideStart = 0.03;
    const hideEnd = 0.12;
    const revealStart = 0.7;
    const revealEnd = 0.85;

    // Fase 1 (prioritaria): un frame ogni 8 + l'ultimo. Bastano ~20 immagini (~1 MB)
    // per rendere lo scrub reattivo; i frame intermedi arrivano dopo, in background.
    const PRIORITY_STEP = 8;
    const MAX_PARALLEL = 6;
    const priority: number[] = [];
    for (let i = 0; i < frameCount; i += PRIORITY_STEP) priority.push(i);
    if (priority[priority.length - 1] !== frameCount - 1) priority.push(frameCount - 1);
    const prioritySet = new Set(priority);
    const rest: number[] = [];
    for (let i = 0; i < frameCount; i++) if (!prioritySet.has(i)) rest.push(i);
    const queue = [...priority, ...rest];
    let priorityLeft = priority.length;
    let inFlight = 0;

    function pump() {
      while (inFlight < MAX_PARALLEL && queue.length) {
        const i = queue.shift()!;
        inFlight++;
        const img = new Image();
        img.decoding = "async";
        const done = (ok: boolean) => {
          inFlight--;
          loaded[i] = ok;
          if (ok && i === 0) resizeCanvas();
          if (prioritySet.has(i) && --priorityLeft === 0) activate();
          else if (ready && ok) requestRender();
          pump();
        };
        img.onload = () => done(true);
        img.onerror = () => done(false);
        img.src = framePath(i + 1, mobile);
        images[i] = img;
      }
    }

    // Frame caricato più vicino a i (cerca in entrambe le direzioni).
    function nearestLoaded(i: number): number {
      if (loaded[i]) return i;
      for (let d = 1; d < frameCount; d++) {
        if (i - d >= 0 && loaded[i - d]) return i - d;
        if (i + d < frameCount && loaded[i + d]) return i + d;
      }
      return -1;
    }

    function drawImageCover(img: HTMLImageElement, alpha: number) {
      const cw = canvas!.width;
      const ch = canvas!.height;
      const scale = Math.max(cw / img.naturalWidth, ch / img.naturalHeight);
      const w = img.naturalWidth * scale;
      const h = img.naturalHeight * scale;
      ctx!.globalAlpha = alpha;
      ctx!.drawImage(img, (cw - w) / 2, (ch - h) / 2, w, h);
    }

    // Disegna la posizione frazionaria con una dissolvenza tra i due frame adiacenti:
    // lo scroll resta fluido anche quando si scorre lentamente.
    function draw() {
      const a = Math.floor(position);
      const b = Math.min(frameCount - 1, a + 1);
      const t = position - a;
      const ia = nearestLoaded(a);
      if (ia < 0) return;
      ctx!.globalAlpha = 1;
      drawImageCover(images[ia]!, 1);
      if (t > 0.02 && b !== a && loaded[b] && loaded[a]) {
        drawImageCover(images[b]!, t);
      }
      ctx!.globalAlpha = 1;
    }

    // Dimensioni prese dal canvas stesso (il contenitore è alto 100svh, stabile): su mobile la
    // barra dell'indirizzo che appare/scompare non provoca ridimensionamenti continui.
    function resizeCanvas() {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const w = Math.round(canvas!.clientWidth * dpr) || Math.round(window.innerWidth * dpr);
      const h = Math.round(canvas!.clientHeight * dpr) || Math.round(window.innerHeight * dpr);
      if (canvas!.width === w && canvas!.height === h) return draw();
      canvas!.width = w;
      canvas!.height = h;
      draw();
    }

    function progressOf(): number {
      const scrollable = section.offsetHeight - window.innerHeight;
      const scrolled = -section.getBoundingClientRect().top;
      return scrollable > 0 ? Math.min(1, Math.max(0, scrolled / scrollable)) : 0;
    }

    function contentOpacity(p: number): number {
      if (p <= hideStart) return 1;
      if (p < hideEnd) return 1 - (p - hideStart) / (hideEnd - hideStart);
      if (p < revealStart) return 0;
      if (p < revealEnd) return (p - revealStart) / (revealEnd - revealStart);
      return 1;
    }

    function render() {
      ticking = false;
      const p = progressOf();
      position = p * (frameCount - 1);
      draw();
      const o = contentOpacity(p);
      content!.style.opacity = String(o);
      content!.style.transform = `translateY(${(1 - o) * 24}px)`;
      content!.classList.toggle("is-hidden", o < 0.5);
    }

    function requestRender() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(render);
    }

    function activate() {
      if (ready) return;
      ready = true;
      section.classList.add("is-frames-ready");
      window.addEventListener("scroll", requestRender, { passive: true });
      window.addEventListener("resize", resizeCanvas, { passive: true });
      resizeCanvas();
      render();
    }

    pump();
  }

  function init() {
    const section = document.querySelector<HTMLElement>(".hero-scrub");
    if (!section) return;

    // La modalità è già stata decisa dallo script inline (prima del primo paint):
    // qui leggiamo semplicemente quale classe ha impostato, senza rivalutare nulla.
    if (section.classList.contains("is-content-visible")) {
      initHeroVideoFallback(section);
      return;
    }

    const mobile = section.classList.contains("is-mobile");
    const frameCount = Number((mobile ? section.dataset.frameCountMobile : section.dataset.frameCount) || 0);
    initHeroScrub(section, frameCount);
  }

  init();
</script>
