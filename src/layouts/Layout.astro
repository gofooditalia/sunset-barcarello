---
import "@fontsource/playfair-display/400.css";
import "@fontsource/playfair-display/700.css";
import "@fontsource-variable/inter";
import "../styles/global.css";
import { site } from "../data/site";

interface Props {
  title?: string;
  description?: string;
}

const { title = site.name, description = site.description } = Astro.props;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Restaurant",
  name: site.name,
  description: site.description,
  url: "https://sunsetbarcarello.it",
  image: "https://sunsetbarcarello.it/images/og-image.jpg",
  servesCuisine: ["Pizza", "Pesce", "Cucina siciliana"],
  address: {
    "@type": "PostalAddress",
    streetAddress: site.address.street,
    addressLocality: site.address.city,
    postalCode: site.address.zip,
    addressRegion: "PA",
    addressCountry: "IT",
  },
  geo: { "@type": "GeoCoordinates", latitude: site.address.lat, longitude: site.address.lng },
  // Aperto tutto l'anno a cena, chiuso il martedì. Orario di chiusura serale non ancora confermato.
  openingHoursSpecification: [
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Monday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
      opens: "17:30",
    },
  ],
  aggregateRating: {
    "@type": "AggregateRating",
    ratingValue: site.rating.value,
    reviewCount: site.rating.count,
  },
  ...(site.phone ? { telephone: site.phone } : {}),
  legalName: site.legal.companyName,
  vatID: `IT${site.legal.vatNumber}`,
  hasMap: site.address.mapsUrl,
  sameAs: [site.social.instagram, site.social.facebook].filter(Boolean),
};
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#0c2436" />
    <meta name="apple-mobile-web-app-title" content="Sunset" />
    <link rel="canonical" href="https://sunsetbarcarello.it/" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:url" content="https://sunsetbarcarello.it/" />
    <meta property="og:site_name" content="Sunset Barcarello" />
    <meta property="og:image" content="https://sunsetbarcarello.it/images/og-image.jpg" />
    <meta property="og:image:secure_url" content="https://sunsetbarcarello.it/images/og-image.jpg" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Tramonto sull'Isola delle Femmine visto da Barcarello" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://sunsetbarcarello.it/images/og-image.jpg" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="bg-cream text-neutral-text antialiased">
    <slot />
  </body>
</html>
